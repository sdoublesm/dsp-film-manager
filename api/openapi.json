          },
          "currentPage": {
            "type": "integer",
            "description": "Current page number"
          },
          "totalItems": {
            "type": "integer",
            "description": "Total number of items"
          },
          "films": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Film"
            }
          },
          "self": {
            "type": "string",
            "format": "uri"
          },
          "first": {
            "type": "string",
            "format": "uri"
          },
          "last": {
            "type": "string",
            "format": "uri"
          },
          "prev": {
            "type": "string",
            "format": "uri"
          },
          "next": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Review": {
        "type": "object",
        "description": "Review data structure",
        "properties": {
          "filmId": {
            "type": "integer",
            "minimum": 1,
            "description": "Identifier of the film"
          },
          "reviewerId": {
            "type": "integer",
            "minimum": 1,
            "description": "Identifier of the invited reviewer"
          },
          "completed": {
            "type": "boolean",
            "description": "Whether the review has been completed"
          },
          "reviewDate": {
            "type": "string",
            "format": "date",
