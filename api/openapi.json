          },
          "rating": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "Rating given to the film"
          },
          "review": {
            "type": "string",
            "maxLength": 1000,
            "description": "Textual review content"
          },
          "self": {
            "type": "string",
            "format": "uri",
            "description": "HATEOAS self link"
          }
        },
        "required": [
