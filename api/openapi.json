{
  "openapi": "3.0.1",
  "info": {
    "title": "Film Manager",
    "description": "REST APIs for the interaction with the Film Manager service.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3001/"
    }
  ],
  "tags": [
    {
      "name": "Api",
      "description": "API entry-point resource"
    },
    {
      "name": "Users",
      "description": "User management and authentication"
    },
    {
      "name": "Films",
      "description": "Film management operations"
    },
    {
      "name": "Reviews",
      "description": "Review invitations and completions"
    }
  ],
  "paths": {
    "/api": {
      "get": {
        "tags": [
          "Api"
        ],
        "summary": "Retrieve the Film Manager entry-point resource",
        "description": "The Film Manager resource, representing the entry point of the REST interface, is retrieved. This operation does not require authentication.",
        "operationId": "getFilmManager",
        "responses": {
          "200": {
            "description": "The Film Manager entry-point resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FilmManager"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/authenticator": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Logs a user in",
        "description": "The user who wants to log in sends their credentials (email and password). If authentication succeeds, an authenticated session cookie is created.",
        "operationId": "authenticateUser",
        "requestBody": {
          "description": "The data of the user who wants to perform log in.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserAuth"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User successfully authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials data"
          },
          "401": {
            "description": "Wrong email or password"
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Logs the current user out",
        "description": "Invalidates the current user session and removes the session cookie.",
        "operationId": "logoutUser",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "User successfully logged out"
          },
          "401": {
            "description": "User not authenticated"
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get information about all users",
        "description": "The available information (passwords excluded) about all users is retrieved. This operation is available only to authenticated users.",
        "operationId": "getUsers",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of all users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "401": {
            "description": "User not authenticated"
          },
          "404": {
            "description": "No users found"
          }
        }
      }
    },
    "/api/users/{userId}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get information about a specific user",
        "description": "The available information (password excluded) about the user specified by userId is retrieved. Requires authentication.",
        "operationId": "getUserById",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "description": "ID of the user to get",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid userId parameter"
          },
          "401": {
            "description": "User not authenticated"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/films": {
      "post": {
        "tags": [
          "Films"
        ],
        "summary": "Create a new film",
        "description": "A new film is created by the authenticated user (who becomes the owner).",
        "operationId": "createFilm",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "description": "Representation of the film to be created",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Film"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Film successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Film"
                }
              }
            }
          },
          "400": {
            "description": "Invalid film data"
          },
          "401": {
            "description": "User not authenticated"
          }
        }
      }
    },
    "/api/films/public": {
      "get": {
        "tags": [
          "Films"
        ],
        "summary": "Retrieve public films",
        "description": "The public films are retrieved. Does not require authentication. Paginated.",
        "operationId": "getPublicFilms",
        "parameters": [
          {
            "name": "pageNo",
            "in": "query",
            "description": "The page number (optional, defaults to 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public films with pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedFilms"
                }
              }
            }
          },
          "400": {
            "description": "Invalid page number"
          },
          "404": {
            "description": "No public films found"
          }
        }
      }
    },
    "/api/films/private": {
      "get": {
        "tags": [
          "Films"
        ],
        "summary": "Retrieve private films of logged-in user",
        "description": "The private films of the logged-in user are retrieved. Paginated.",
        "operationId": "getPrivateFilms",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "pageNo",
            "in": "query",
            "description": "The page number (optional, defaults to 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Private films with pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedFilms"
                }
              }
            }
          },
          "400": {
            "description": "Invalid page number"
          },
          "401": {
            "description": "User not authenticated"
          },
          "404": {
            "description": "No private films found"
          }
        }
      }
    },
    "/api/films/public/invited": {
      "get": {
        "tags": [
          "Films"
        ],
        "summary": "Retrieve public films user is invited to review",
        "description": "The public films that the logged-in user has been invited to review are retrieved. Paginated.",
        "operationId": "getInvitedFilms",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "pageNo",
            "in": "query",
            "description": "The page number (optional, defaults to 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invited films with pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedFilms"
                }
              }
            }
          },
          "400": {
            "description": "Invalid page number"
          },
          "401": {
            "description": "User not authenticated"
          },
          "404": {
            "description": "No invited films found"
          }
        }
      }
    },
    "/api/films/public/{filmId}": {
      "get": {
        "tags": [
          "Films"
        ],
        "summary": "Retrieve a single public film",
        "description": "The public film with ID filmId is retrieved. Does not require authentication.",
        "operationId": "getSinglePublicFilm",
        "parameters": [
          {
            "name": "filmId",
            "in": "path",
            "description": "ID of the film to retrieve",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The public film",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Film"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filmId parameter"
          },
          "404": {
            "description": "Film not found or not public"
          }
        }
      },
      "put": {
        "tags": [
          "Films"
        ],
        "summary": "Update a public film",
        "description": "The public film with ID filmId is updated. Cannot change its visibility. Can only be performed by the owner.",
        "operationId": "updateSinglePublicFilm",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "filmId",
            "in": "path",
            "description": "ID of the film to update",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "description": "The updated film object",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Film"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Film successfully updated"
          },
          "400": {
            "description": "Invalid film data"
          },
          "401": {
            "description": "User not authenticated"
          },
          "403": {
            "description": "User is not the owner or trying to change visibility"
          },
          "404": {
            "description": "Film not found or not public"
          }
        }
      },
      "delete": {
        "tags": [
          "Films"
        ],
        "summary": "Delete a public film",
        "description": "The public film with ID filmId is deleted. Can only be performed by the owner.",
        "operationId": "deleteSinglePublicFilm",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "filmId",
            "in": "path",
            "description": "ID of the film to delete",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Film successfully deleted"
          },
          "400": {
            "description": "Invalid filmId parameter"
          },
          "401": {
            "description": "User not authenticated"
          },
          "403": {
            "description": "User is not the owner"
          },
          "404": {
            "description": "Film not found or not public"
          }
        }
      }
    },
    "/api/films/private/{filmId}": {
      "get": {
        "tags": [
          "Films"
        ],
        "summary": "Retrieve a single private film",
        "description": "The private film with ID filmId is retrieved. Can be performed only by the owner.",
        "operationId": "getSinglePrivateFilm",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "filmId",
            "in": "path",
            "description": "ID of the film to retrieve",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The private film",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Film"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filmId parameter"
          },
          "401": {
            "description": "User not authenticated"
          },
          "403": {
            "description": "User is not the owner"
          },
          "404": {
            "description": "Film not found or not private"
          }
        }
      },
      "put": {
        "tags": [
          "Films"
        ],
        "summary": "Update a private film",
        "description": "The private film with ID filmId is updated. Cannot change its visibility. Can only be performed by the owner.",
        "operationId": "updateSinglePrivateFilm",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "filmId",
            "in": "path",
            "description": "ID of the film to update",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "description": "The updated film object",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Film"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Film successfully updated"
          },
          "400": {
            "description": "Invalid film data"
          },
          "401": {
            "description": "User not authenticated"
          },
          "403": {
            "description": "User is not the owner or trying to change visibility"
          },
          "404": {
            "description": "Film not found or not private"
          }
        }
      },
      "delete": {
        "tags": [
          "Films"
        ],
        "summary": "Delete a private film",
        "description": "The private film with ID filmId is deleted. Can only be performed by the owner.",
        "operationId": "deleteSinglePrivateFilm",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "filmId",
            "in": "path",
            "description": "ID of the film to delete",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Film successfully deleted"
          },
          "400": {
            "description": "Invalid filmId parameter"
          },
          "401": {
            "description": "User not authenticated"
          },
          "403": {
            "description": "User is not the owner"
          },
          "404": {
            "description": "Film not found or not private"
          }
        }
      }
    },
    "/api/films/public/{filmId}/reviews": {
      "get": {
        "tags": [
          "Reviews"
        ],
        "summary": "Retrieve reviews for a public film",
        "description": "All reviews that have been issued/completed for the public film with ID filmId are retrieved. Paginated. Does not require authentication.",
        "operationId": "getFilmReviews",
        "parameters": [
          {
            "name": "filmId",
            "in": "path",
            "description": "ID of the film whose reviews must be retrieved",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "pageNo",
            "in": "query",
            "description": "The page number (optional, defaults to 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of reviews with pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedReviews"
                }
              }
            }
          },
          "400": {
            "description": "Invalid film ID or page number"
          },
          "404": {
            "description": "Film or reviews not found"
          }
        }
      },
      "post": {
        "tags": [
          "Reviews"
        ],
        "summary": "Issue review invitations for a public film",
        "description": "The film with ID filmId is assigned to one or more users for review. Can only be performed by the film owner.",
        "operationId": "issueFilmReview",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "filmId",
            "in": "path",
            "description": "ID of the film",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "description": "The list of new review invitations",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Review"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Review invitations successfully issued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Review"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid review invitation data"
          },
          "401": {
            "description": "User not authenticated"
          },
          "403": {
            "description": "User is not the owner or film is private"
          },
          "404": {
            "description": "Film not found"
          },
          "409": {
            "description": "Review invitation already issued for user"
          }
        }
      }
    },
    "/api/films/public/{filmId}/reviews/{reviewerId}": {
      "get": {
        "tags": [
          "Reviews"
        ],
        "summary": "Retrieve a single review of a public film",
        "description": "The review of the film with ID filmId issued to the user with ID reviewerId is retrieved. Does not require authentication.",
        "operationId": "getSingleReview",
        "parameters": [
          {
            "name": "filmId",
            "in": "path",
            "description": "ID of the film",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "reviewerId",
            "in": "path",
            "description": "ID of the reviewer",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Review"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filmId or reviewerId parameter"
          },
          "404": {
            "description": "Review not found"
          }
        }
      },
      "put": {
        "tags": [
          "Reviews"
        ],
        "summary": "Complete a review",
        "description": "Marks the review as completed, setting reviewDate, rating, and review text. Can only be performed by the invited reviewer.",
        "operationId": "updateSingleReview",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "filmId",
            "in": "path",
            "description": "ID of the film",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "reviewerId",
            "in": "path",
            "description": "ID of the reviewer",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "description": "The completed review object",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Review"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Review successfully completed"
          },
          "400": {
            "description": "Invalid review data"
          },
          "401": {
            "description": "User not authenticated"
          },
          "403": {
            "description": "User is not the invited reviewer"
          },
          "404": {
            "description": "Review not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Reviews"
        ],
        "summary": "Delete a review invitation",
        "description": "The review invitation is deleted. Can only be performed by the film owner, and only if the review has not yet been completed.",
        "operationId": "deleteSingleReview",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "filmId",
            "in": "path",
            "description": "ID of the film",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "reviewerId",
            "in": "path",
            "description": "ID of the reviewer",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Review invitation successfully deleted"
          },
          "400": {
            "description": "Invalid filmId or reviewerId parameter"
          },
          "401": {
            "description": "User not authenticated"
          },
          "403": {
            "description": "User is not the film owner"
          },
          "404": {
            "description": "Review not found"
          },
          "409": {
            "description": "Review has already been completed and cannot be deleted"
          }
        }
      }
    },
    "/api/films/public/reviews/assignments": {
      "post": {
        "tags": [
          "Reviews"
        ],
        "summary": "Automatically issue review invitations",
        "description": "Automatically issues review invitations for all public films without any existing invitations, ensuring even distribution among users. (Design mandatory, implementation optional).",
        "operationId": "assignReviewInvitations",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Review invitations automatically assigned"
          },
          "401": {
            "description": "User not authenticated"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FilmManager": {
        "type": "object",
        "description": "The Film Manager entry point resource with navigational links",
        "properties": {
          "films": {
            "type": "string",
            "format": "uri"
          },
          "privateFilms": {
            "type": "string",
            "format": "uri"
          },
          "publicFilms": {
            "type": "string",
            "format": "uri"
          },
          "invitedPublicFilms": {
            "type": "string",
            "format": "uri"
          },
          "reviewAssignments": {
            "type": "string",
            "format": "uri"
          },
          "users": {
            "type": "string",
            "format": "uri"
          },
          "usersAuthenticator": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "User": {
        "type": "object",
        "description": "User representation",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "Unique identifier of the user"
          },
          "name": {
            "type": "string",
            "description": "Username of the user"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the user"
          },
          "self": {
            "type": "string",
            "format": "uri",
            "description": "HATEOAS self link"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "UserAuth": {
        "type": "object",
        "description": "Credentials required for user authentication",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the user"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 20,
            "description": "Password of the user"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Film": {
        "type": "object",
        "description": "Film data structure",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "Unique identifier of the film"
          },
          "title": {
            "type": "string",
            "description": "Textual title of the film"
          },
          "owner": {
            "type": "integer",
            "minimum": 1,
            "description": "ID of the user who created the film"
          },
          "private": {
            "type": "boolean",
            "description": "True if private, false if public"
          },
          "watchDate": {
            "type": "string",
            "format": "date",
            "description": "Date when film was watched (private films only)"
          },
          "rating": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "Rating given by owner (private films only)"
          },
          "favorite": {
            "type": "boolean",
            "default": false,
            "description": "Whether film is favorite (private films only)"
          },
          "self": {
            "type": "string",
            "format": "uri",
            "description": "HATEOAS self link"
          },
          "reviews": {
            "type": "string",
            "format": "uri",
            "description": "Link to the reviews of the film (for public films)"
          }
        },
        "required": [
          "title",
          "private"
        ]
      },
      "PaginatedFilms": {
        "type": "object",
